ENVIRONMENT=development
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=*

# Origens liberadas pra chamar esta API via CORS (o front ap-front, em dev
# local, roda no Vite em localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local Postgres via docker-compose, se disponível na sua máquina — deixe
# vazio para conectar direto no Cloud SQL (ver abaixo) quando não tiver Docker.
LOCAL_DATABASE_URL=

# Cloud SQL — usados só quando LOCAL_DATABASE_URL está vazio. Em dev, aponta
# pra instância de baixo custo contratos-db (registradora-506000, us-east1);
# em produção, pra instância real de produção.
CLOUDSQL_CONNECTION_NAME=
CLOUDSQL_DB_USER=
CLOUDSQL_DB_PASSWORD=
CLOUDSQL_DB_NAME=
CLOUDSQL_IP_TYPE=PUBLIC

# CERC (homologação) — credenciais próprias deste serviço, ver
# docs/superpowers/specs/2026-08-24-contratos-service-design.md §5
CERC_CLIENT_ID=
CERC_CLIENT_SECRET=
CERC_AUTH_URL=https://api.int.cerc.com/oauth/token
CERC_API_BASE_URL=https://ap-homolog.cerc.inf.br

ENVIRONMENT=development
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=*

# Origens liberadas pra chamar esta API via CORS (o front ap-front, em dev
# local, roda no Vite em localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CERC — hosts do ambiente (não variam por tenant, ver §1.1 do design doc)
CERC_AUTH_URL=https://api.int.cerc.com/oauth/token
CERC_API_BASE_URL=https://ap-homolog.cerc.inf.br

# Push subscription do Pub/Sub (Plano 11) — audiência esperada no ID token
# OIDC que o Pub/Sub assina em cada push. PUBSUB_PUSH_INVOKER_SA é OBRIGATÓRIO
# (não apenas uma allowlist extra): a claim `audience` de um ID token OIDC do
# Google não é, por si só, uma fronteira de autenticação — qualquer identidade
# Google autenticada pode pedir um token para qualquer audiência. Sem
# PUBSUB_PUSH_INVOKER_SA configurado, toda requisição de push é recusada.
# Defina com o e-mail exato da conta de serviço que a push subscription do
# Pub/Sub usa para assinar as requisições.
PUBSUB_PUSH_AUDIENCE=https://contratos-homolog.example.com/api/v1/webhooks/contrato/processar
PUBSUB_PUSH_INVOKER_SA=pubsub-push@PROJECT_ID.iam.gserviceaccount.com

# Config por tenant (financiador) — um segredo por tenant, ver
# docs/superpowers/specs/2026-08-24-contratos-service-design.md §1.1.
# Em produção/homolog isso vem do Secret Manager (mesma chave); em dev,
# é uma env var local com o JSON completo numa linha só.
TENANT_12345678000199_CONFIG_CONTRATOS={"cloudsql_connection_name": "", "cloudsql_db_user": "", "cloudsql_db_password": "", "cloudsql_db_name": "", "cloudsql_ip_type": "PUBLIC", "cerc_client_id": "", "cerc_client_secret": "", "webhook_basic_user": "", "webhook_basic_password": ""}
